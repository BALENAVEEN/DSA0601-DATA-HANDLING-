# Data
months <- 1:3

ProductA <- c(2000,2200,2400)
ProductB <- c(1500,1800,1600)
ProductC <- c(1200,1400,1100)

# Stacked Area Chart
plot(months,
     ProductA,
     type="l",
     lwd=2,
     ylim=c(1000,2500),
     xlab="Month",
     ylab="Sales ($)",
     main="Monthly Sales Trend")

lines(months, ProductB, col="red", lwd=2)
lines(months, ProductC, col="blue", lwd=2)

legend("topleft",
       legend=c("Product A","Product B","Product C"),
       col=c("black","red","blue"),
       lty=1)
