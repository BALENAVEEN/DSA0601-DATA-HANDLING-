# Monthly Sales Data

# Create the data
month <- c("January", "February", "March", "April", "May")
sales <- c(15000, 18000, 22000, 20000, 23000)

# Create a line chart
plot(sales,
     type = "o",
     xaxt = "n",
     xlab = "Month",
     ylab = "Sales ($)",
     main = "Monthly Sales Trend")

# Add month names to x-axis
axis(1, at = 1:5, labels = month)
